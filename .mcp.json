{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--logFile",
        "/tmp/chrome-devtools-mcp.log",
        "--no-usage-statistics",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=bdferrsxitaszvoednvg&features=database,docs"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io"
    }
  }
}
